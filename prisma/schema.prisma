generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Salon {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  phone       String?
  email       String
  address     String?
  city        String?
  country     String?
  timezone    String   @default("America/New_York")
  logo        String?
  coverImage  String?
  openTime    String   @default("09:00")
  closeTime   String   @default("18:00")
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff         StaffMember[]
  services      Service[]
  clients       Client[]
  appointments  Appointment[]
  reviews       Review[]
  notifications Notification[]
  whatsappConfig WhatsAppConfig?
  campaigns     Campaign[]
}

model StaffMember {
  id        String   @id @default(cuid())
  salonId   String
  email     String
  password  String
  firstName String
  lastName  String
  phone     String?
  avatar    String?
  role      String   @default("STYLIST")
  bio       String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services     ServiceStaff[]
  appointments Appointment[]
  reviews      Review[]
  schedule     StaffSchedule[]

  @@unique([email, salonId])
}

model StaffSchedule {
  id        String  @id @default(cuid())
  staffId   String
  dayOfWeek Int
  startTime String
  endTime   String
  isOff     Boolean @default(false)

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
}

model Service {
  id          String  @id @default(cuid())
  salonId     String
  name        String
  description String?
  duration    Int
  price       Float
  category    String?
  color       String? @default("#d946ef")
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salon        Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staff        ServiceStaff[]
  appointments Appointment[]
}

model ServiceStaff {
  id        String @id @default(cuid())
  serviceId String
  staffId   String

  service Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff   StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([serviceId, staffId])
}

model Client {
  id        String  @id @default(cuid())
  salonId   String
  firstName String
  lastName  String
  email     String?
  phone     String
  notes     String?
  tags      String  @default("")
  source    String? @default("walk-in")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  reviews      Review[]

  @@unique([phone, salonId])
}

model Appointment {
  id        String   @id @default(cuid())
  salonId   String
  clientId  String
  staffId   String
  serviceId String
  date      DateTime
  startTime String
  endTime   String
  status    String   @default("PENDING")
  price     Float
  notes     String?
  source    String   @default("ONLINE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salon   Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  client  Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff   StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  review  Review?
  messages WhatsAppMessage[]

  @@index([salonId, date])
  @@index([staffId, date])
}

model Review {
  id            String  @id @default(cuid())
  salonId       String
  clientId      String
  staffId       String
  appointmentId String  @unique
  rating        Int
  comment       String?
  isPublic      Boolean @default(true)
  response      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salon       Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff       StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  salonId   String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  String?
  createdAt DateTime @default(now())

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, isRead])
}

model WhatsAppConfig {
  id              String  @id @default(cuid())
  salonId         String  @unique
  phoneNumberId   String
  accessToken     String
  businessId      String
  verifyToken     String
  isActive        Boolean @default(true)
  autoConfirm     Boolean @default(true)
  reminderHours   Int     @default(24)
  followUpHours   Int     @default(2)

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model WhatsAppMessage {
  id            String   @id @default(cuid())
  appointmentId String?
  direction     String
  phoneNumber   String
  message       String
  templateName  String?
  status        String   @default("SENT")
  waMessageId   String?
  createdAt     DateTime @default(now())

  appointment Appointment? @relation(fields: [appointmentId], references: [id])
}

model Campaign {
  id        String   @id @default(cuid())
  salonId   String
  name      String
  message   String
  targetTags String  @default("")
  status    String   @default("DRAFT")
  sentCount Int      @default(0)
  sentAt    DateTime?
  createdAt DateTime @default(now())

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
}
